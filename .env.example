# GateKeeper API Gateway Configuration
ENV=development
DEBUG=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
ADMIN_API_KEY=your_secure_admin_key_here

# Upstream Server Endpoints
UPSTREAM_URL=http://localhost:8001
UPSTREAM_SERVER_1_URL=http://localhost:8001
UPSTREAM_SERVER_2_URL=http://localhost:8002
UPSTREAM_SERVER_3_URL=http://localhost:8003
UPSTREAM_SERVER_4_URL=http://localhost:8004

# Load Balancer Defaults
DEFAULT_LOAD_BALANCER_ALGORITHM=round_robin
DEFAULT_ACTIVE_SERVER_COUNT=4

# Timeouts & Circuit Breaker
GATEWAY_TIMEOUT_SECONDS=10.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=15.0
CIRCUIT_BREAKER_WINDOW_SECONDS=30
