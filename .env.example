# GateKeeper API Gateway Environment Variables

# Application Settings
ENV=development
DEBUG=True
GATEWAY_PORT=8080

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=0.25
REDIS_CONNECT_TIMEOUT=0.25

# Admin Security (IMPORTANT: Change this to a strong, unique secret in production)
ADMIN_API_KEY=your-secure-admin-key-here

# Upstream Backend Configuration
# Default upstream for local development outside Docker Compose (e.g., `uvicorn main:app --port 8000`)
UPSTREAM_URL=http://127.0.0.1:8001

# Upstream servers for multi-server load balancing
UPSTREAM_SERVER_1_URL=http://127.0.0.1:8001
UPSTREAM_SERVER_2_URL=http://127.0.0.1:8002
UPSTREAM_SERVER_3_URL=http://127.0.0.1:8003
UPSTREAM_SERVER_4_URL=http://127.0.0.1:8004

# Load Balancer Settings
DEFAULT_LOAD_BALANCER_ALGORITHM=round_robin # Options: round_robin, least_connections, ip_hash, random
DEFAULT_ACTIVE_SERVER_COUNT=4 # Number of active upstream nodes (1-4)

# Gateway HTTP Client Settings
GATEWAY_TIMEOUT_SECONDS=10.0
HTTP_MAX_CONNECTIONS=500
HTTP_MAX_KEEPALIVE_CONNECTIONS=100
HTTP_KEEPALIVE_EXPIRY_SECONDS=30.0

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=15
CIRCUIT_BREAKER_WINDOW_SECONDS=30

# CORS and Host Configuration
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# ALLOWED_HOSTS=localhost,127.0.0.1
# RATE_LIMIT_WHITELIST_IPS=127.0.0.1
