# GateKeeper API Gateway Environment Variables

# Application Settings
PROJECT_NAME="GateKeeper API Gateway"
DEBUG=False
ENV=development

# Redis Configuration
REDIS_URL="redis://127.0.0.1:6379/0"
REDIS_SOCKET_TIMEOUT=0.25
REDIS_CONNECT_TIMEOUT=0.25

# Security & Authentication
API_KEY_HEADER_NAME=X-API-Key
ADMIN_API_KEY_HEADER_NAME=X-Admin-Key
ADMIN_API_KEY="admin-secret-gatekeeper-key"

# Rate Limiting Settings
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_TIER=free
# RATE_LIMIT_TIERS is defined in config.py and cannot be easily overridden via .env as a dict.
# To override, you would need to modify the config.py directly or use a more advanced config management.
RATE_LIMIT_WHITELIST_IPS="127.0.0.1,::1"

# Gateway / HTTP Connection Pool Settings
GATEWAY_TIMEOUT_SECONDS=5.0
UPSTREAM_URL="http://127.0.0.1:8001"
UPSTREAM_SERVER_1_URL="http://127.0.0.1:8001"
UPSTREAM_SERVER_2_URL="http://127.0.0.1:8002"
UPSTREAM_SERVER_3_URL="http://127.0.0.1:8003"
UPSTREAM_SERVER_4_URL="http://127.0.0.1:8004"
DEFAULT_LOAD_BALANCER_ALGORITHM=round_robin
DEFAULT_ACTIVE_SERVER_COUNT=4
HTTP_MAX_KEEPALIVE_CONNECTIONS=100
HTTP_MAX_CONNECTIONS=500
HTTP_KEEPALIVE_EXPIRY_SECONDS=30.0

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=15
CIRCUIT_BREAKER_WINDOW_SECONDS=30

# CORS & Trusted Hosts
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
ALLOWED_HOSTS="localhost,127.0.0.1,test,*"
