# GateKeeper API Gateway Environment Variables Example
# Copy this file to .env and adjust values as needed.

# --- Core Gateway Settings ---
# Runtime environment: development, production, test
ENV=production
# Enable debug logging (true/false)
DEBUG=false
# Port on the host machine to expose the gateway (docker-compose only)
GATEWAY_PORT=8080

# --- Redis Configuration ---
# Redis connection URL. For docker-compose, use 'redis://redis:6379/0'
REDIS_URL=redis://redis:6379/0
# Redis socket I/O timeout in seconds
REDIS_SOCKET_TIMEOUT=0.25
# Redis connection timeout in seconds
REDIS_CONNECT_TIMEOUT=0.25

# --- Security & Authentication ---
# Header name for client API key. Default: X-API-Key
API_KEY_HEADER_NAME=X-API-Key
# Header name for administrator authentication. Default: X-Admin-Key
ADMIN_API_KEY_HEADER_NAME=X-Admin-Key
# Secret key for administrator operations (CRITICAL: CHANGE THIS IN PRODUCTION)
ADMIN_API_KEY=your_secure_admin_key_here

# --- Upstream Servers & Load Balancing ---
# Default upstream URL (used if load balancer is not explicitly configured)
UPSTREAM_URL=http://mock_backend:8001
# Target URLs for individual upstream nodes. For docker-compose, use 'http://mock_backend:800x'
UPSTREAM_SERVER_1_URL=http://mock_backend:8001
UPSTREAM_SERVER_2_URL=http://mock_backend:8002
UPSTREAM_SERVER_3_URL=http://mock_backend:8003
UPSTREAM_SERVER_4_URL=http://mock_backend:8004
# Default load balancing algorithm (round_robin, least_connections, ip_hash, random)
DEFAULT_LOAD_BALANCER_ALGORITHM=round_robin
# Default count of active upstream nodes (1 to 4)
DEFAULT_ACTIVE_SERVER_COUNT=4

# --- HTTP Client Pool Settings ---
# Upstream HTTP request timeout in seconds
GATEWAY_TIMEOUT_SECONDS=10.0
# Max total HTTP connections in pool
HTTP_MAX_CONNECTIONS=500
# Max idle keep-alive HTTP connections
HTTP_MAX_KEEPALIVE_CONNECTIONS=100
# Keep-alive connection idle expiry in seconds
HTTP_KEEPALIVE_EXPIRY_SECONDS=30.0

# --- Rate Limiting Settings ---
# Rolling rate limit window duration in seconds
RATE_LIMIT_WINDOW_SECONDS=60
# Client IPs to bypass rate limiting (comma-separated, e.g., 192.0.2.1,10.0.0.5)
RATE_LIMIT_WHITELIST_IPS=

# --- Circuit Breaker Settings ---
# Upstream failures required to trip circuit to OPEN
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Cooldown period before transitioning to HALF_OPEN
CIRCUIT_BREAKER_RECOVERY_SECONDS=15
# Failure counter evaluation window in seconds
CIRCUIT_BREAKER_WINDOW_SECONDS=30

# --- CORS & Host Security ---
# Allowed CORS origins (comma-separated, e.g., http://localhost:3000,http://localhost:8000)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Allowed host headers (comma-separated, e.g., localhost,127.0.0.1,your.domain.com)
ALLOWED_HOSTS=localhost,127.0.0.1,test,*